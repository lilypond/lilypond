#: convertrules.py:1959
msgid ""
"Page layout has been changed, using paper size and margins.\n"
"textheight is no longer used.\n"
msgstr ""
"Lapas izkārtojums ir mainīts; tiek izmantots papīra izmērs un malas.\n"
"textheight vairs netiek izmantots.\n"

#: convertrules.py:2084
msgid ""
"staff size should be changed at top-level\n"
"with\n"
"\n"
"  #(set-global-staff-size <STAFF-HEIGHT-IN-POINT>)\n"
"\n"
msgstr ""
"nošu līnijas izmērs jāmaina augšējā līmenī\n"
"ar\n"
"\n"
"  #(set-global-staff-size <STAFF-HEIGHT-IN-POINT>)\n"
"\n"

#: convertrules.py:2184
msgid "LilyPond source must be UTF-8"
msgstr "LilyPond pirmkodam jābūt UTF-8"

#: convertrules.py:2187
