#: convertrules.py:1484
#, python-format
msgid ""
"\\outputproperty found,\n"
"Please hand-edit, using\n"
"\n"
"  \\applyoutput #(outputproperty-compatibility %s '%s <GROB PROPERTY VALUE>)\n"
"\n"
"as a substitution text"
msgstr ""
"atrasts \\outputproperty,\n"
"lūdzu, rediģējiet manuāli, izmantojot\n"
"\n"
"  \\applyoutput #(outputproperty-compatibility %s '%s <GROB PROPERTY VALUE>)\n"
"\n"
"kā aizstāšanas tekstu"

#: convertrules.py:1496
msgid ""
"The alteration field of Scheme pitches was multiplied by 2\n"
"to support quarter tone accidentals.  You must update the following constructs manually:\n"
"\n"
"* calls of ly:make-pitch and ly:pitch-alteration\n"
"* keySignature settings made with \\property\n"
msgstr ""
"Scheme augstumu alterācijas lauks tika reizināts ar 2,\n"
"lai atbalstītu ceturtdaļtoņu alterācijas zīmes.  Šīs konstrukcijas jāatjaunina manuāli:\n"
"\n"
"* ly:make-pitch un ly:pitch-alteration izsaukumi\n"
"* keySignature iestatījumi, kas veikti ar \\property\n"

#: convertrules.py:1675
msgid "Drums found. Enclose drum notes in \\drummode"
msgstr "Atrastas bungas. Ievietojiet bungu notis \\drummode"

