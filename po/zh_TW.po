#: musicxml2ly.py:5208
msgid "--lxml is obsolete, ignoring"
msgstr "--lxml 已過時，忽略"

#: musicxml2ly.py:5209
msgid "obsolete"
msgstr "已過時"

#: musicxml2ly.py:5215
msgid "input file is a compressed MusicXML file (by default, activate if file extension is .mxl)"
msgstr "輸入檔案是壓縮的 MusicXML 檔案（預設在副檔名為 .mxl 時啟用）"

#: musicxml2ly.py:5222
msgid "convert pitches in relative mode (default)"
msgstr "轉換為相對音高（預設）"

#: musicxml2ly.py:5227
msgid "convert pitches in absolute mode"
msgstr "轉換為絕對音高"

#: musicxml2ly.py:5230
msgid "LANG"
msgstr "語言"

#: musicxml2ly.py:5232
msgid "use LANG for pitch names, e.g., 'deutsch' for note names in German"
msgstr "使用 LANG 作為音高名稱，例如 'deutsch' 用於德語音符名稱"

#: musicxml2ly.py:5244 musicxml2ly.py:5383
msgid "t[rue]/f[alse]"
msgstr "t[rue]/f[alse]（真/假）"

#: musicxml2ly.py:5247
msgid "expect <octave-shift> end elements before the associated <note> (as in Finale). Default is f[alse]"
msgstr "預期在相關聯的 <note> 之前有 <octave-shift> 結束元素（如 Finale 中）。預設為 f[alse]"

#: musicxml2ly.py:5255
msgid "do not convert directions (^, _ or -) for articulations, dynamics, etc."
msgstr "不轉換方向記號（^、_ 或 -）用於演奏法、力度等"

#: musicxml2ly.py:5262
msgid "do not convert exact vertical positions of rests"
msgstr "不轉換休止符的確實垂直位置"

#: musicxml2ly.py:5268
msgid "ignore system breaks"
msgstr "忽略系統分頁"

#: musicxml2ly.py:5274
msgid "ignore page breaks"
msgstr "忽略分頁"

#: musicxml2ly.py:5280
msgid "ignore page margins"
msgstr "忽略頁面邊界"

