\version "2.27.6"

\header {
  categories = "Midi, Scheme"

  texidoc = "
Pitch bend messages can be sent from a Scheme performer.  The effect of a
pitch bend value depends on the pitch bend range of the instrument, so the
range is set first.  With a range of two semitones, the value 8192 means no
bend, 12288 is one semitone up and 4096 is one semitone down.
"

  doctitle = "Bending pitch from a Scheme performer"
} % begin verbatim


#(define (bend-example context)
   (let ((count 0))
     (make-performer
      ((process-music performer)
       (case count
         ((0)
          (midi-announce-pitch-bend-range performer 2)
          (midi-announce-pitch-bend performer 8192))
         ((1)
          (midi-announce-pitch-bend performer 12288))
         ((2)
          (midi-announce-pitch-bend performer 8192))
         ((3)
          (midi-announce-pitch-bend performer 4096)))
       (set! count (1+ count))))))

\score {
  \new Staff { g'2 g' g' g' }
  \layout { }
  \midi {
    \context {
      \Staff
      \consists #bend-example
    }
  }
}
